# ============================================================
# ResearchOS Environment Configuration
# ============================================================

# Core Settings
APP_NAME=ResearchOS
ENVIRONMENT=production
OPERATING_MODE=FREE_ONLY
FREE_ONLY=true
MAX_SPEND_AUD=0.0
ALLOW_PAID_EXECUTION=false

# Localization Defaults (Australia / Brisbane)
DEFAULT_COUNTRY=AU
DEFAULT_CURRENCY=AUD
DEFAULT_TIMEZONE=Australia/Brisbane
DEFAULT_LOCATION="Brisbane, Queensland, Australia"

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///data/researchos.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# AI Provider API Keys (Optional - Free-first policy applies)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Local AI Inference Endpoints
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Search Provider API Keys (DuckDuckGo & Google News require 0 keys)
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=

# Code & Community Integrations
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# Monitoring & Webhooks
DEFAULT_MONITOR_INTERVAL_HOURS=12
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Ports
API_PORT=8000
WEB_PORT=3000
HOST=0.0.0.0